PORT=4000
HOST=0.0.0.0
DASHBOARD_ORIGIN=http://localhost:5173

# Africa's Talking (SMS) - Sandbox
# Placeholders only. Never commit real credentials to this file.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_api_key_here

# --- Aegis Alert Engine ---
# Destination for critical security alerts. Use international format,
# e.g. +234XXXXXXXXXX. Leave blank to disable SMS dispatch; the gateway
# still records alerts and logs a warning.
AEGIS_ALERT_SMS_RECIPIENT=+234XXXXXXXXXX

# Alert-storm protection: suppress repeat alerts for the same
# deviceId + event within this window. Defaults to 60000 (60s).
AEGIS_ALERT_COOLDOWN_MS=60000

# Provider request timeout in milliseconds. Defaults to 10000.
AEGIS_ALERT_SMS_TIMEOUT_MS=10000

# Whether HIGH severity alerts (currently DEVICE_OFFLINE) are sent by SMS.
# CRITICAL alerts are always sent. Defaults to false.
AEGIS_ALERT_HIGH_SMS_ENABLED=false